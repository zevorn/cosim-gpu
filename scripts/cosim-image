#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
workspace="${COSIM_WORKSPACE:-$(dirname "$script_dir")}"
cd "$workspace"
export PYTHONDONTWRITEBYTECODE=1
exec python3 -m resources.images.cli --workspace "$workspace" "$@"
